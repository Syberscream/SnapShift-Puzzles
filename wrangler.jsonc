{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snapshift-puzzles",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Static site built by Vite into dist/. The Worker only handles /api/* and /media/*.
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snapshift",
      // Replace with the id printed by: npx wrangler d1 create snapshift
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "snapshift-media" }
  ],
  // Every 10 minutes: plan new ElevenLabs generations and collect finished ones.
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    "APP_NAME": "SnapShift Puzzles",
    "APP_URL": "https://snapshiftpuzzles.com",
    "MAIL_FROM": "SnapShift Puzzles <hello@snapshiftpuzzles.com>",
    "ADMIN_EMAILS": "syberscream@gmail.com",
    "ELEVENLABS_BASE_URL": "https://api.elevenlabs.io",
    "TIMEZONE": "America/Vancouver"
  },
  // Secrets (set with `npx wrangler secret put NAME`, or .dev.vars locally):
  //   ELEVENLABS_API_KEY  – ElevenLabs key with Image & Video access (Pro plan+)
  //   RESEND_API_KEY      – for verification / password-reset email (optional)
  "observability": { "enabled": true }
}
