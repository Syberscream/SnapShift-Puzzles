{
  "name": "snapshift-puzzles",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch & wrangler dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply snapshift --local",
    "db:migrate:remote": "wrangler d1 migrations apply snapshift --remote",
    "start": "wrangler dev",
    "deploy": "vite build && wrangler d1 migrations apply snapshift --remote && wrangler deploy",
    "build:portal": "node scripts/build-portal.mjs",
    "preview:portal": "vite preview --config vite.portal.config.ts --outDir ../dist-portal/snapshift-web --open"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
